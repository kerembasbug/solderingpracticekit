---
import type { ResolvedSet } from '@/lib/sets';
import { setHref } from '@/lib/sets';
import { affiliateUrl, affiliateCartUrl } from '@/lib/amazon/links';
import { absoluteUrl } from '@/lib/seo';

interface Props {
  set: ResolvedSet;
  /** Heading level for the set title (h2 inside articles, h1 on the set's own page). */
  as?: 'h1' | 'h2';
  /** Show the "See the full set page" link (off when already on that page). */
  showPageLink?: boolean;
  /** Reported to GA4 as `cta_position` on the set button. */
  position?: 'inline' | 'hero' | 'footer';
  /** Emit ItemList JSON-LD for this set (off when the page already includes it). */
  schema?: boolean;
}

const { set, as: Heading = 'h2', showPageLink = true, position = 'inline', schema = true } = Astro.props;

const cartAsins = set.items.filter((i) => !i.optional).map((i) => i.asin);
const cartUrl = affiliateCartUrl(cartAsins);
const SET_CTA = 'Get Set on Amazon →';
const ITEM_CTA = 'Check Price →';

const jsonLd = schema
  ? JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'ItemList',
      name: set.title,
      description: set.tagline,
      url: absoluteUrl(setHref(set.id)),
      numberOfItems: set.items.length,
      itemListElement: set.items.map((i, idx) => ({
        '@type': 'ListItem',
        position: idx + 1,
        name: i.title,
        url: i.reviewHref ? absoluteUrl(i.reviewHref) : affiliateUrl(i.asin),
      })),
    })
  : null;
---

<section
  id={`set-${set.id}`}
  class="scroll-mt-24 overflow-hidden rounded-3xl border border-ink-200 bg-white shadow-[var(--shadow-card)]"
  aria-labelledby={`set-${set.id}-title`}
>
  <div class="border-b border-ink-100 bg-ink-50 px-6 py-5 lg:px-8">
    <p class="text-xs font-bold uppercase tracking-wide text-brand-600">Shopping set · {set.items.length} items</p>
    <Heading id={`set-${set.id}-title`} class="mt-1 text-2xl font-extrabold tracking-tight text-ink-900">{set.title}</Heading>
    <p class="mt-2 max-w-3xl leading-relaxed text-ink-600">{set.intro}</p>
  </div>

  <ol class="divide-y divide-ink-100">
    {
      set.items.map((item, idx) => (
        <li class="flex gap-4 px-6 py-4 lg:px-8">
          <a
            href={item.reviewHref ?? affiliateUrl(item.asin)}
            {...(item.reviewHref ? {} : { target: '_blank', rel: 'sponsored nofollow noopener' })}
            class="block h-16 w-16 shrink-0 overflow-hidden rounded-lg border border-ink-100 bg-white p-1"
            aria-label={item.reviewHref ? `Read our ${item.title} review` : `${item.title} on Amazon (opens in a new tab)`}
            tabindex="-1"
          >
            <img src={item.image} alt="" width={item.imageWidth} height={item.imageHeight} loading="lazy" decoding="async" class="h-full w-full object-contain" />
          </a>
          <div class="min-w-0 flex-1">
            <p class="text-xs font-semibold uppercase tracking-wide text-ink-500">
              {idx + 1}. {item.role}
            </p>
            <p class="mt-0.5 font-bold leading-snug text-ink-900">
              {item.reviewHref ? (
                <a href={item.reviewHref} class="hover:text-brand-600">{item.title}</a>
              ) : (
                item.title
              )}
            </p>
            <p class="mt-1 text-sm leading-relaxed text-ink-600">{item.why}</p>
            <p class="mt-2 flex flex-wrap items-center gap-x-4 gap-y-1 text-sm">
              <a
                href={affiliateUrl(item.asin)}
                target="_blank"
                rel="sponsored nofollow noopener"
                aria-label={`Check price: ${item.title} (opens in a new tab)`}
                data-cta-label={ITEM_CTA}
                data-cta-position="inline"
                class="inline-flex min-h-11 items-center font-semibold text-brand-600 hover:text-brand-700"
              >
                {ITEM_CTA}
              </a>
              {item.reviewHref && (
                <a href={item.reviewHref} class="inline-flex min-h-11 items-center text-ink-500 hover:text-brand-600">
                  Read review
                </a>
              )}
            </p>
          </div>
        </li>
      ))
    }
  </ol>

  <div class="border-t border-ink-100 bg-ink-50 px-6 py-5 lg:px-8">
    <div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
      <a
        href={cartUrl}
        target="_blank"
        rel="sponsored nofollow noopener"
        aria-label={`Get the ${set.title} set on Amazon: adds all ${cartAsins.length} items to your Amazon cart (opens in a new tab)`}
        data-cta-label={SET_CTA}
        data-cta-position={position}
        class="btn-buy hover:btn-buy-hover min-h-11 px-6 py-3 text-base active:scale-[0.99]"
      >
        {SET_CTA}
      </a>
      {
        showPageLink && (
          <a href={setHref(set.id)} class="text-sm font-semibold text-brand-600 hover:text-brand-700">
            Why these {set.items.length} items →
          </a>
        )
      }
    </div>
    <p class="mt-3 text-xs leading-relaxed text-ink-500">
      Adds all {cartAsins.length} items to your Amazon cart in one step — remove anything you already own before checkout. We earn a commission on qualifying purchases, at no extra cost to you.
    </p>
  </div>
</section>
{jsonLd && <script type="application/ld+json" set:html={jsonLd} />}
