---
import BaseHead from '@/components/BaseHead.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import { SITE } from '@/config/site';

interface Props {
  title: string;
  description: string;
  image?: string;
  type?: 'website' | 'article';
  jsonLd?: string;
  noindex?: boolean;
  publishedTime?: string;
  modifiedTime?: string;
}

const props = Astro.props;
const path = Astro.url.pathname;
---

<!doctype html>
<html lang={SITE.language}>
  <head>
    <BaseHead {...props} path={path} />
  </head>
  <body class="flex min-h-screen flex-col">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-[100] focus:rounded-md focus:bg-ink-900 focus:px-4 focus:py-2 focus:text-white"
    >
      Skip to content
    </a>
    <Header />
    <main id="main" class="flex-1">
      <slot />
    </main>
    <Footer />
    <script is:inline>
      // Every CTA click -> GA4 `cta_click` (cta_label, cta_position, page_type).
      document.addEventListener('click', function (e) {
        var el = e.target.closest && e.target.closest('[data-cta-label]');
        if (!el) return;
        var p = location.pathname;
        var pageType =
          p === '/' ? 'home'
          : p.indexOf('/reviews/') === 0 && p.length > 9 ? 'review'
          : p.indexOf('/guides/') === 0 && p.length > 8 ? 'guide'
          : p.indexOf('/best-') === 0 ? 'roundup'
          : p.indexOf('-vs-') > -1 ? 'comparison'
          : 'other';
        var params = {
          cta_label: el.getAttribute('data-cta-label'),
          cta_position: el.getAttribute('data-cta-position') || 'inline',
          page_type: pageType,
          transport_type: 'beacon',
        };
        if (typeof window.gtag === 'function') window.gtag('event', 'cta_click', params);
        else (window.dataLayer = window.dataLayer || []).push(Object.assign({ event: 'cta_click' }, params));
      });
    </script>
  </body>
</html>
