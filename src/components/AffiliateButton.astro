---
import type { Product } from '@/lib/types';
import { affiliateUrl } from '@/lib/amazon/links';

export type CtaPosition = 'hero' | 'card' | 'inline' | 'sticky' | 'footer';

interface Props {
  product: Product;
  /** `card` for lists/cards, `detail` for review pages — maps to the CTA dictionary. */
  variant?: 'card' | 'detail';
  /** Reported to GA4 as `cta_position`. */
  position?: CtaPosition;
  size?: 'sm' | 'md' | 'lg';
  fullWidth?: boolean;
  /** Show the "Price as of …" / commission line under the button. */
  showTimestamp?: boolean;
}

const {
  product,
  variant = 'detail',
  position = 'inline',
  size = 'md',
  fullWidth = false,
  showTimestamp = true,
} = Astro.props;

const href = affiliateUrl(product.asin);
const live = product.live;
const text = variant === 'card' ? 'Check Price →' : 'Check Price on Amazon →';

const pad =
  size === 'lg' ? 'px-6 py-3.5 text-base' : size === 'sm' ? 'px-4 py-2.5 text-sm' : 'px-5 py-3 text-[0.95rem]';

const asOf = live?.fetchedAt
  ? new Date(live.fetchedAt).toLocaleString('en-US', {
      month: 'short',
      day: 'numeric',
      year: 'numeric',
      hour: 'numeric',
      minute: '2-digit',
    })
  : null;
---

<div class:list={[fullWidth ? 'w-full' : 'inline-block']}>
  <a
    href={href}
    target="_blank"
    rel="sponsored nofollow noopener"
    aria-label={`${text.replace(' →', '')}: ${product.title} (opens in a new tab)`}
    data-cta-label={text}
    data-cta-position={position}
    class:list={['btn-buy hover:btn-buy-hover min-h-11 active:scale-[0.99]', pad, fullWidth && 'w-full']}
  >
    {text}
  </a>
  {
    showTimestamp && asOf && (
      <p class="mt-1.5 text-center text-[0.7rem] leading-tight text-ink-500">
        Price as of {asOf}. {live?.isPrimeEligible ? 'Prime eligible. ' : ''}Details on Amazon.
      </p>
    )
  }
  {
    showTimestamp && !asOf && (
      <p class="mt-1.5 text-center text-[0.7rem] leading-tight text-ink-500">
        We earn a commission, at no extra cost to you.
      </p>
    )
  }
</div>
