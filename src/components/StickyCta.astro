---
import type { Product } from '@/lib/types';
import AffiliateButton from '@/components/AffiliateButton.astro';

interface Props {
  product: Product;
}
const { product } = Astro.props;
---

<!-- Hidden until the in-page hero CTAs scroll out of view, so two identical buttons never stack. -->
<div
  data-sticky-cta
  class="fixed inset-x-0 bottom-0 z-40 translate-y-full border-t border-ink-200 bg-white/95 px-4 pb-[max(0.75rem,env(safe-area-inset-bottom))] pt-3 shadow-[0_-4px_16px_rgb(0_0_0/0.06)] backdrop-blur transition-transform duration-200 lg:hidden"
  aria-hidden="true"
>
  <div class="flex items-center gap-3">
    <img src={product.image} alt="" width="44" height="44" loading="lazy" decoding="async" class="h-11 w-11 shrink-0 rounded-md border border-ink-100 bg-white object-contain" />
    <p class="min-w-0 flex-1 truncate text-sm font-semibold text-ink-900">{product.title}</p>
    <div class="shrink-0">
      <AffiliateButton product={product} variant="card" position="sticky" size="sm" showTimestamp={false} />
    </div>
  </div>
</div>
<div class="h-20 lg:hidden" aria-hidden="true"></div>

<script>
  const bar = document.querySelector<HTMLElement>('[data-sticky-cta]');
  const heroes = document.querySelectorAll('[data-cta-position="hero"]');
  if (bar && 'IntersectionObserver' in window) {
    const visible = new Set<Element>();
    const setShown = (shown: boolean) => {
      bar.classList.toggle('translate-y-full', !shown);
      bar.setAttribute('aria-hidden', String(!shown));
      bar.querySelectorAll('a').forEach((a) => (a.tabIndex = shown ? 0 : -1));
    };
    const io = new IntersectionObserver((entries) => {
      for (const e of entries) (e.isIntersecting ? visible.add(e.target) : visible.delete(e.target));
      setShown(visible.size === 0 && window.scrollY > 200);
    });
    heroes.forEach((h) => io.observe(h));
    window.addEventListener('scroll', () => setShown(visible.size === 0 && window.scrollY > 200), { passive: true });
    setShown(false);
  } else if (bar) {
    bar.classList.remove('translate-y-full');
    bar.setAttribute('aria-hidden', 'false');
  }
</script>
